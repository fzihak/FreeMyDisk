---
import { squarify, type Item } from "../lib/treemap";

// A sample 512 GB laptop drive. Junk tiles map to real FreeMyDisk rule categories.
const items: Item[] = [
  { label: "Games", gb: 96, kind: "apps" },
  { label: "Videos", gb: 71, kind: "user" },
  { label: "Program Files", gb: 64, kind: "apps" },
  { label: "Pictures", gb: 52, kind: "user" },
  { label: "Documents", gb: 38, kind: "user" },
  { label: "Windows", gb: 33, kind: "system" },
  { label: "Downloads", gb: 29, kind: "user" },
  { label: "Hugging Face models", gb: 17.6, kind: "junk", rule: "AI caches" },
  { label: "Docker build cache", gb: 12.4, kind: "junk", rule: "Containers" },
  { label: "npm / pnpm cache", gb: 9.8, kind: "junk", rule: "Development" },
  { label: "Recycle Bin", gb: 7.7, kind: "junk", rule: "System" },
  { label: "Cargo & Gradle", gb: 6.9, kind: "junk", rule: "Development" },
  { label: "Browser caches", gb: 5.4, kind: "junk", rule: "Browser" },
  { label: "Temp files", gb: 4.6, kind: "junk", rule: "System" },
  { label: "Shader caches", gb: 3.1, kind: "junk", rule: "System" },
  { label: "App caches", gb: 2.8, kind: "junk", rule: "Applications" },
  { label: "Crash dumps", gb: 1.9, kind: "junk", rule: "System" },
];
const W = 1000;
const H = 520;
const GAP = 2;
const tiles = squarify(items, 0, 0, W, H);
const junkTotal = items.filter((i) => i.kind === "junk").reduce((a, b) => a + b.gb, 0);
const usedTotal = items.reduce((a, b) => a + b.gb, 0);
---
<figure class="diskmap panel" data-junk={junkTotal.toFixed(1)}>
  <figcaption class="dm-bar">
    <div class="dm-left">
      <span class="dot"></span>
      <span class="mono">C:\</span>
      <span class="dim mono">Local Disk · 512 GB</span>
    </div>
    <div class="dm-status mono" aria-live="polite">
      <span class="dm-phase">Scanning 122 rules…</span>
    </div>
    <div class="dm-right mono">
      <span class="dim">reclaimed</span>
      <span class="dm-count">0.0</span><span class="dim">GB</span>
    </div>
  </figcaption>

  <div class="dm-stage">
    <svg viewBox={`0 0 ${W} ${H}`} role="img" aria-label={`Treemap of a ${usedTotal.toFixed(0)} GB drive with ${junkTotal.toFixed(1)} GB of reclaimable junk highlighted`}>
      <defs>
        <pattern id="hatch" width="7" height="7" patternUnits="userSpaceOnUse" patternTransform="rotate(45)">
          <rect width="7" height="7" fill="#0a0a0a" />
          <line x1="0" y1="0" x2="0" y2="7" stroke="rgba(74,222,128,0.22)" stroke-width="1.5" />
        </pattern>
        <linearGradient id="scan" x1="0" x2="1">
          <stop offset="0" stop-color="#ff691f" stop-opacity="0" />
          <stop offset="0.85" stop-color="#ff691f" stop-opacity="0.18" />
          <stop offset="1" stop-color="#ff691f" stop-opacity="0.9" />
        </linearGradient>
      </defs>
      {tiles.map((t) => {
        const x = t.x + GAP / 2, y = t.y + GAP / 2, w = Math.max(0, t.w - GAP), h = Math.max(0, t.h - GAP);
        const big = w > 120 && h > 52;
        const mid = w > 74 && h > 30;
        return (
          <g class={`tile k-${t.kind}`} data-x={x} data-gb={t.gb}>
            <rect class="base" x={x} y={y} width={w} height={h} rx="0" />
            <rect class="freed" x={x} y={y} width={w} height={h} rx="0" fill="url(#hatch)" />
            {mid && (
              <text x={x + 10} y={y + 20} class="t-label">{t.label}</text>
            )}
            {big && (
              <text x={x + 10} y={y + 38} class="t-size">{t.gb} GB{t.rule ? ` · ${t.rule}` : ""}</text>
            )}
          </g>
        );
      })}
      <rect class="scanline" x="-140" y="0" width="140" height={H} fill="url(#scan)" />
    </svg>
  </div>

  <div class="dm-legend mono">
    <span><i class="sw sw-system"></i>System</span>
    <span><i class="sw sw-apps"></i>Apps &amp; games</span>
    <span><i class="sw sw-user"></i>Your files — never touched</span>
    <span><i class="sw sw-junk"></i>Reclaimable junk</span>
    <button class="replay" type="button" aria-label="Replay the scan animation">↻ Replay</button>
  </div>
</figure>

<script>
  const fig = document.querySelector<HTMLElement>(".diskmap");
  if (fig) {
    const svg = fig.querySelector("svg")!;
    const scan = fig.querySelector<SVGRectElement>(".scanline")!;
    const count = fig.querySelector<HTMLElement>(".dm-count")!;
    const phase = fig.querySelector<HTMLElement>(".dm-phase")!;
    const junk = [...fig.querySelectorAll<SVGGElement>(".k-junk")];
    const reduced = matchMedia("(prefers-reduced-motion: reduce)").matches;
    const total = parseFloat(fig.dataset.junk || "0");
    let timers: number[] = [];
    let raf = 0;

    const reset = () => {
      timers.forEach(clearTimeout);
      cancelAnimationFrame(raf);
      timers = [];
      fig.classList.remove("found", "done");
      junk.forEach((g) => g.classList.remove("hit", "gone"));
      count.textContent = "0.0";
      scan.setAttribute("x", "-140");
      phase.textContent = "Scanning 122 rules…";
    };

    const countTo = (target: number, ms: number) => {
      const start = performance.now();
      const step = (now: number) => {
        const p = Math.min(1, (now - start) / ms);
        const eased = 1 - Math.pow(1 - p, 3);
        count.textContent = (target * eased).toFixed(1);
        if (p < 1) raf = requestAnimationFrame(step);
      };
      raf = requestAnimationFrame(step);
    };

    const play = () => {
      reset();
      if (reduced) {
        junk.forEach((g) => g.classList.add("hit"));
        fig.classList.add("found");
        phase.textContent = `Found ${total.toFixed(1)} GB of junk`;
        return;
      }
      const W = 1000, dur = 2600, start = performance.now();
      const sweep = (now: number) => {
        const p = Math.min(1, (now - start) / dur);
        const x = -140 + p * (W + 140);
        scan.setAttribute("x", String(x));
        junk.forEach((g) => { if (+(g.dataset.x || 0) < x + 120) g.classList.add("hit"); });
        if (p < 1) { raf = requestAnimationFrame(sweep); return; }
        fig.classList.add("found");
        phase.textContent = `Found ${total.toFixed(1)} GB of junk · cleaning`;
        const ordered = [...junk].sort((a, b) => +(b.dataset.gb || 0) - +(a.dataset.gb || 0));
        ordered.forEach((g, i) => timers.push(window.setTimeout(() => g.classList.add("gone"), 700 + i * 150)));
        timers.push(window.setTimeout(() => countTo(total, 150 * ordered.length + 400), 700));
        timers.push(window.setTimeout(() => {
          fig.classList.add("done");
          phase.textContent = "Done · moved to Recycle Bin, journaled";
        }, 900 + 150 * ordered.length + 400));
      };
      raf = requestAnimationFrame(sweep);
    };

    const io = new IntersectionObserver((e) => {
      if (e[0].isIntersecting) { io.disconnect(); timers.push(window.setTimeout(play, 500)); }
    }, { threshold: 0.35 });
    io.observe(svg);
    fig.querySelector(".replay")?.addEventListener("click", play);
  }
</script>

<style>
  .diskmap { margin: 0; overflow: hidden; background: var(--term); border: 1px solid var(--line-strong); }
  .dm-bar {
    display: grid; grid-template-columns: 1fr auto 1fr; align-items: center; gap: 12px;
    padding: 12px 16px; border-bottom: 1px solid var(--line); font-size: 13px;
    font-family: var(--font-mono);
  }
  .dm-left { display: flex; align-items: center; gap: 10px; }
  .dot { width: 8px; height: 8px; background: var(--accent); box-shadow: 0 0 12px var(--accent); }
  .dm-status { color: var(--text-2); font-size: 12.5px; text-align: center; }
  :global(.diskmap.done) .dm-status { color: var(--ok); }
  .dm-right { justify-self: end; display: flex; align-items: baseline; gap: 6px; }
  .dm-count { font-size: 20px; font-weight: 600; color: var(--text); font-variant-numeric: tabular-nums; min-width: 3.4ch; text-align: right; }
  :global(.diskmap.found) .dm-count { color: var(--junk); }
  :global(.diskmap.done) .dm-count { color: var(--ok); }
  .dm-stage { padding: 14px; }
  svg { width: 100%; height: auto; }
  .base { transition: fill .5s ease, opacity .6s ease; }
  .k-system .base { fill: #242424; }
  .k-apps .base { fill: #1c1c1c; }
  .k-user .base { fill: #151515; }
  .k-junk .base { fill: #1f1f1f; }
  .freed { opacity: 0; transition: opacity .5s ease; }
  :global(.tile.hit) .base { fill: #4a1f08; }
  :global(.tile.hit) .t-label, :global(.tile.hit) .t-size { fill: #ffb27f; }
  :global(.tile.gone) .base { opacity: 0; }
  :global(.tile.gone) .freed { opacity: 1; }
  :global(.tile.gone) .t-label, :global(.tile.gone) .t-size { fill: rgba(74, 222, 128, 0.7); }
  .t-label { font: 600 13px var(--font-display); fill: #d6d6d2; letter-spacing: -0.01em; pointer-events: none; }
  .t-size { font: 500 11px var(--font-mono); fill: #7a7a76; pointer-events: none; }
  .k-user .t-label { fill: #9a9a96; }
  .scanline { mix-blend-mode: screen; }
  .dm-legend {
    display: flex; flex-wrap: wrap; gap: 8px 22px; align-items: center;
    padding: 12px 16px 14px; border-top: 1px solid var(--line); font-size: 12px; color: var(--text-3);
  }
  .dm-legend span { display: inline-flex; align-items: center; gap: 8px; }
  .sw { width: 10px; height: 10px; display: inline-block; }
  .sw-system { background: #242424; box-shadow: inset 0 0 0 1px #333; }
  .sw-apps { background: #1c1c1c; box-shadow: inset 0 0 0 1px #2c2c2c; }
  .sw-user { background: #151515; box-shadow: inset 0 0 0 1px #262626; }
  .sw-junk { background: var(--junk); }
  .replay { margin-left: auto; background: none; border: 1px solid var(--line-strong); color: var(--text-2); font: inherit; padding: 5px 10px; cursor: pointer; text-transform: uppercase; letter-spacing: .08em; font-size: 11px; }
  .replay:hover { color: var(--text); border-color: rgba(255,255,255,.25); }
  @media (max-width: 700px) {
    .dm-bar { grid-template-columns: 1fr auto; }
    .dm-status { display: none; }
    .t-size { display: none; }
    .dm-left .dim { display: none; }
  }
</style>
