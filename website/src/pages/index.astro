---
import Base from "../layouts/Base.astro";
import DiskMap from "../components/DiskMap.astro";
import Sweep from "../components/Sweep.astro";
import Arrow from "../components/Arrow.astro";
import WindowsLogo from "../components/WindowsLogo.astro";
import { SITE, formatDate, readingMinutes } from "../lib/site";
import { getCollection } from "astro:content";

const posts = (await getCollection("blog", ({ data }) => !data.draft))
  .sort((a, b) => b.data.date.getTime() - a.data.date.getTime())
  .slice(0, 3);

const ruleCats = [
  { name: "Applications", n: 41, eg: "Spotify, Teams, Discord, Slack, Steam, Adobe…" },
  { name: "Development", n: 32, eg: "npm, pnpm, Cargo, Gradle, NuGet, VS Code, JetBrains…" },
  { name: "Browsers", n: 19, eg: "Chrome, Edge, Firefox, Brave, Opera, Arc…" },
  { name: "System", n: 14, eg: "Temp, Windows Update, crash dumps, shader caches…" },
  { name: "AI tools", n: 12, eg: "Hugging Face, Ollama, LM Studio, ComfyUI, Cursor…" },
  { name: "Containers", n: 4, eg: "Docker build cache, WSL disks…" },
];
const maxCat = Math.max(...ruleCats.map((c) => c.n));

const tools = [
  ["Dashboard", "Drive health, one-click Clean Now, low-space rescue."],
  ["Deep Cleanup", "122 rules, each with owner app, risk level and size."],
  ["Space Visualizer", "Interactive treemap of any drive or folder."],
  ["Large Files", "The biggest files on every drive, filterable."],
  ["Duplicates", "Byte-identical copies, confirmed with BLAKE3."],
  ["Privacy Cleaner", "History, cookies and caches — per browser."],
  ["Apps & Leftovers", "Uninstall apps and hunt what they leave behind."],
  ["Startup Apps", "Boot impact for every startup entry."],
  ["Maintenance", "Repair caches, DNS, search index, Windows Update."],
  ["Optimizer", "Hibernation, Storage Sense, WSL and Docker disks."],
  ["Audit Log", "Every operation, and what's queued for restart."],
];

const journal = [
  ["INTENT", "Write the deletion to the crash-safe journal", "before anything is touched on disk"],
  ["CHECK", "Re-check the path against the protected-path registry", "Windows, Program Files, your profile, the app itself"],
  ["CHECK", "Skip files a running app is holding open", "and caches of a browser that's still running"],
  ["CHECK", "Keep anything modified in the last 24 hours", "temp and dump cleaning never races a running install"],
  ["TRASH", "Move to the Recycle Bin", "if that fails, the file is kept — never silently deleted"],
  ["COMMIT", "Mark the journal entry done", "an interrupted cleanup is recovered on the next start"],
];

const bench = [
  { label: "Scan 122 cleanup rules", before: 27, after: 9, unit: "s" },
  { label: "Large files · 5 drives", before: 269, after: 47, unit: "s" },
  { label: "Duplicates · 5 drives", before: 390, after: 177, unit: "s" },
];

const jsonLd = {
  "@context": "https://schema.org",
  "@type": "SoftwareApplication",
  name: "FreeMyDisk",
  operatingSystem: "Windows 10, Windows 11",
  applicationCategory: "UtilitiesApplication",
  softwareVersion: SITE.version,
  offers: { "@type": "Offer", price: "0", priceCurrency: "USD" },
  downloadUrl: SITE.download,
  license: "https://www.gnu.org/licenses/gpl-3.0.html",
};
---

<Base jsonLd={jsonLd}>
  <!-- ============================================================ HERO -->
  <section class="hero">
    <div class="wrap">
      <div class="eyebrow">Your disk · Your files · Your call</div>
      <h1 class="h-display hero-title">Free the gigabytes. <br class="br-lg" /> Keep every file you need.</h1>
      <p class="lede hero-lede">
        FreeMyDisk finds the caches, leftovers and duplicates filling your Windows drive. <br class="br-lg" />
        It tells you what each one is and which app made it. <br class="br-lg" />
        Everything it removes goes to the Recycle Bin first.
      </p>
      <div class="hero-cta">
        <a class="btn btn-primary" href={SITE.download}>
          <WindowsLogo />
          <span>Download for Windows</span>
          <Arrow />
        </a>
        <a class="btn" href={SITE.repo}>
          <span>Star on GitHub</span>
          <Arrow />
        </a>
      </div>
      <p class="hero-meta label">Free · v{SITE.version} · Windows 10 &amp; 11 · GPL-3.0 · No telemetry</p>
    </div>
    <div class="wrap hero-sweep reveal">
      <Sweep />
    </div>
  </section>

  <!-- ============================================================ 01 CLEANUP -->
  <div class="cross"></div>
  <section class="section" id="cleanup">
    <div class="wrap">
      <div class="meta-bar">
        <span class="id">01 // Cleanup</span>
        <span>Rules: <b>{SITE.rules}</b></span>
        <span>Risk: <b>Labelled</b></span>
        <span>Undo: <b>Recycle Bin</b></span>
      </div>

      <div class="split">
        <div>
          <h2 class="h-section">Knows where every app hides its junk.</h2>
          <p class="lede split-lede">
            {SITE.rules} hand-written rules say which folders each app rebuilds on its own, and which ones it doesn't. Nothing is guessed from file names.
          </p>
          <a class="cta-link" href={`${SITE.repo}/tree/main/rules`}><span>Read the rules</span><Arrow /></a>
        </div>
        <ol class="numbered reveal">
          {ruleCats.map((c, i) => (
            <li>
              <span class="n mono">{String(i + 1).padStart(2, "0")}</span>
              <span class="k label">{c.name} <span class="dim">· {c.n}</span></span>
              <span class="d">{c.eg}</span>
            </li>
          ))}
        </ol>
      </div>

      <div class="cards reveal">
        {tools.map(([name, desc], i) => (
          <div class="card">
            <div class="card-top label"><span class="accent">{String(i + 1).padStart(2, "0")}</span><span>{name}</span></div>
            <p>{desc}</p>
          </div>
        ))}
        <a class="card card-cta" href={SITE.download}>
          <div class="card-top label"><span class="accent">12</span><span>Your turn</span></div>
          <p class="cta-link"><span>Get the app</span><Arrow /></p>
        </a>
      </div>
    </div>
  </section>

  <!-- ============================================================ 02 SPACE MAP -->
  <div class="cross"></div>
  <section class="section" id="map">
    <div class="wrap">
      <div class="meta-bar">
        <span class="id">02 // Space map</span>
        <span>Drive: <b>C:\ 512 GB</b></span>
        <span>Junk: <b>Highlighted</b></span>
        <span>Data: <b>Sample</b></span>
      </div>
      <div class="split split-tight">
        <h2 class="h-section">See the whole drive. Then see the junk.</h2>
        <p class="lede">The Space Visualizer draws any drive or folder as a treemap. Run a scan and the reclaimable parts light up, sized by what you would actually get back.</p>
      </div>
      <div class="reveal map-frame"><DiskMap /></div>
    </div>
  </section>

  <!-- ============================================================ 03 SAFETY -->
  <div class="cross"></div>
  <section class="section" id="safety">
    <div class="wrap">
      <div class="meta-bar">
        <span class="id">03 // Safety</span>
        <span>Writes: <b>Journaled</b></span>
        <span>Deletes: <b>Recycle Bin</b></span>
        <span>Runs as: <b>User</b></span>
      </div>
      <div class="split">
        <div>
          <h2 class="h-section">Every deletion writes a receipt first.</h2>
          <p class="lede split-lede">
            A bug, a crash or a misclick can't cost you a file. This is what happens to every item FreeMyDisk removes.
          </p>
          <ul class="promises">
            <li><span class="label accent">01</span> Runs as a normal user. Admin tasks go through a small allow-listed helper behind UAC.</li>
            <li><span class="label accent">02</span> Shows what it will do before it does it. Anything permanent says so.</li>
            <li><span class="label accent">03</span> Never counts space it can't actually free.</li>
          </ul>
        </div>
        <div class="journal reveal" aria-label="Disposal journal">
          <div class="term-bar"><i></i><i></i><i></i><span class="title">journal.db · WAL · fsync</span></div>
          <ol>
            {journal.map(([op, what, why], i) => (
              <li style={`--d:${i * 90}ms`}>
                <span class={`op op-${op.toLowerCase()} mono`}>{op}</span>
                <span>
                  <span class="j-what">{what}</span>
                  <span class="j-why">{why}</span>
                </span>
              </li>
            ))}
          </ol>
        </div>
      </div>
    </div>
  </section>

  <!-- ============================================================ 04 SPEED -->
  <div class="cross"></div>
  <section class="section" id="speed">
    <div class="wrap">
      <div class="meta-bar">
        <span class="id">04 // Speed</span>
        <span>Engine: <b>Rust</b></span>
        <span>Threads: <b>Every core</b></span>
        <span>Hashing: <b>BLAKE3</b></span>
      </div>
      <div class="speed-hero reveal">
        <div class="striped speed-num">{bench[0].before}s<span class="to"> → </span>{bench[0].after}s</div>
        <div>
          <p class="speed-copy">A full scan of all {SITE.rules} rules, measured on a real 5-drive PC. Version {SITE.version} against the first build.</p>
          <a class="cta-link" href={SITE.repo}><span>Read the source</span><Arrow /></a>
        </div>
      </div>
      <div class="bench">
        {bench.map((b) => (
          <div class="bench-row reveal">
            <span class="label">{b.label}</span>
            <span class="bench-bars">
              <span class="bar-before" style="--w:100%"><span class="mono">{b.before}{b.unit}</span></span>
              <span class="bar-after" style={`--w:${(b.after / b.before) * 100}%`}><span class="mono">{b.after}{b.unit}</span></span>
            </span>
            <span class="bench-x striped">{(b.before / b.after).toFixed(1)}×</span>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- ============================================================ 05 DEMO -->
  <div class="cross"></div>
  <section class="section" id="demo">
    <div class="wrap">
      <div class="meta-bar">
        <span class="id">05 // The app</span>
        <span>UI: <b>Native WebView2</b></span>
        <span>Installer: <b>7 MB</b></span>
        <span>Theme: <b>Light / Dark</b></span>
      </div>
      <div class="split split-tight">
        <h2 class="h-section">Thirty seconds, start to clean.</h2>
        <p class="lede">The real app, recorded as-is. Large Files and Duplicates show sample data, so nobody's private files end up on the internet.</p>
      </div>
      <div class="backdrop demo-frame reveal">
        <div class="win-frame">
          <div class="term-bar"><i></i><i></i><i></i><span class="title">FreeMyDisk</span></div>
          <img src="/media/demo.webp" alt="FreeMyDisk scanning junk, finding large files and duplicates, and switching themes" width="1100" height="688" loading="lazy" />
        </div>
      </div>
    </div>
  </section>

  <!-- ============================================================ 06 CLI -->
  <div class="cross"></div>
  <section class="section" id="cli">
    <div class="wrap">
      <div class="meta-bar">
        <span class="id">06 // Command line</span>
        <span>Output: <b>Text · JSON · CSV</b></span>
        <span>Dry run: <b>Every command</b></span>
      </div>
      <div class="split">
        <div>
          <h2 class="h-section">Same engine. Scriptable.</h2>
          <p class="lede split-lede">
            <span class="mono">freemydisk-cli</span> ships with the app. Every command has a dry run, and nothing is asked when you pass <span class="mono">--yes</span>.
          </p>
        </div>
        <div class="term reveal">
          <div class="term-bar"><i></i><i></i><i></i><span class="title">PowerShell</span></div>
<pre class="mono"><span class="dim">PS&gt;</span> freemydisk-cli clean --category development --dry-run
<span class="dim">rule                                 items     size  action</span>
pnpm store cache                       105   <span class="junk">56.4 MB</span>  recycle
Cargo registry cache                   369   <span class="junk">67.3 MB</span>  recycle
Gradle build cache                   2,114   <span class="junk"> 1.9 GB</span>  recycle
VS Code workspace storage               12   <span class="junk">48.1 KB</span>  recycle
<span class="dim">────────────────────────────────────────────────────────</span>
<span class="ok">dry run</span> · 4 rules · 2,600 items · <span class="junk">2.02 GB</span> would be freed

<span class="dim">PS&gt;</span> freemydisk-cli duplicates --roots "D:\Photos" --format json<span class="caret"></span></pre>
        </div>
      </div>
    </div>
  </section>

  <!-- ============================================================ 07 OPEN SOURCE -->
  <div class="cross"></div>
  <section class="section" id="open-source">
    <div class="wrap">
      <div class="meta-bar">
        <span class="id">07 // Open source</span>
        <span>License: <b>GPL-3.0</b></span>
        <span>Rules: <b>TOML</b></span>
        <span>Builds: <b>Attested</b></span>
      </div>
      <div class="split">
        <div>
          <h2 class="h-section">Your app's cache could be rule #{SITE.rules + 1}.</h2>
          <p class="lede split-lede">
            A rule is 20 lines of TOML. A translation is one file. A bug report is a form. Every contribution is credited in the release notes.
          </p>
          <div class="row-btns">
            <a class="btn btn-primary" href={`${SITE.repo}/issues/new?template=cleanup_rule.yml`}><span>Suggest a rule</span><Arrow /></a>
            <a class="btn" href={`${SITE.repo}/blob/main/CONTRIBUTING.md`}><span>Contributor guide</span><Arrow /></a>
          </div>
        </div>
        <div class="term reveal">
          <div class="term-bar"><i></i><i></i><i></i><span class="title">rules/application/spotify.toml</span></div>
<pre class="mono"><span class="k">[rule]</span>
id = <span class="s">"windows_application_spotify_cache"</span>
name = <span class="s">"Spotify Media &amp; Storage Cache"</span>
risk = <span class="s">"safe"</span>
locking_processes = [<span class="s">"spotify.exe"</span>]

<span class="k">[targets]</span>
paths = [&#123; path = <span class="s">"$&#123;local_app_data&#125;/Spotify/Data/*"</span> &#125;]

<span class="k">[disposal]</span>
protect_subpaths = [<span class="s">"*/Users/*"</span>]</pre>
        </div>
      </div>
    </div>
  </section>

  <!-- ============================================================ BLOG -->
  {posts.length > 0 && (
    <>
      <div class="cross"></div>
      <section class="section">
        <div class="wrap">
          <div class="meta-bar">
            <span class="id">08 // Blog</span>
            <span>Format: <b>Long reads</b></span>
            <span>Feed: <b>RSS</b></span>
          </div>
          <div class="posts-head">
            <h2 class="h-section">Guides that respect your time.</h2>
            <a class="cta-link" href="/blog"><span>All articles</span><Arrow /></a>
          </div>
          <div class="posts">
            {posts.map((p, i) => (
              <a class="post reveal" href={`/blog/${p.id}`}>
                <span class="n mono accent">{String(i + 1).padStart(2, "0")}</span>
                <span class="post-title">{p.data.title}</span>
                <span class="post-desc">{p.data.description}</span>
                <span class="label">{formatDate(p.data.date)} · {readingMinutes(p.body ?? "")} min</span>
                <Arrow />
              </a>
            ))}
          </div>
        </div>
      </section>
    </>
  )}

  <!-- ============================================================ CTA -->
  <div class="cross"></div>
  <section class="section final">
    <div class="wrap">
      <div class="eyebrow">Free forever · Open source · Signed updates</div>
      <h2 class="h-display final-title">Get your gigabytes back.</h2>
      <div class="hero-cta">
        <a class="btn btn-primary" href={SITE.download}><WindowsLogo /><span>Download for Windows</span><Arrow /></a>
        <a class="btn" href={SITE.releases}><span>All releases</span><Arrow /></a>
      </div>
      <p class="verify label">Verify any installer: <span class="mono">gh attestation verify FreeMyDisk-Setup-x64.exe --repo fzihak/FreeMyDisk</span></p>
    </div>
  </section>
</Base>

<style>
  /* hero */
  .hero { padding: clamp(56px, 8vw, 104px) 0 clamp(64px, 8vw, 104px); }
  .hero-title { margin-top: 26px; }
  .hero-lede { margin-top: 28px; max-width: 62ch; }
  .hero-cta { display: flex; flex-wrap: wrap; gap: 12px; margin-top: 36px; }
  .hero-meta { margin: 20px 0 0; font-size: 11px; color: var(--text-3); }
  .hero-sweep { margin-top: clamp(48px, 6vw, 72px); }
  @media (max-width: 760px) { .br-lg { display: none; } }

  /* split: big heading left, content right */
  .split { display: grid; grid-template-columns: 1fr 1fr; gap: clamp(36px, 6vw, 96px); margin-top: clamp(40px, 5vw, 64px); align-items: start; }
  .split-tight { align-items: end; }
  .split-lede { margin: 24px 0 32px; }
  @media (max-width: 960px) { .split { grid-template-columns: 1fr; } }

  /* numbered list: 01  APPLICATIONS · 41   Spotify, Teams… */
  .numbered { list-style: none; margin: 0; padding: 0; border-top: 1px solid var(--line); }
  .numbered li { display: grid; grid-template-columns: 36px 180px 1fr; gap: 16px; align-items: baseline; padding: 20px 0; border-bottom: 1px solid var(--line); }
  .numbered .n { color: var(--accent); font-size: 12px; }
  .numbered .k { color: var(--text); }
  .numbered .d { font-size: 16px; line-height: 1.35; color: var(--text-2); }
  @media (max-width: 560px) { .numbered li { grid-template-columns: 30px 1fr; } .numbered .d { grid-column: 2; } }

  /* tool cards */
  .cards { display: grid; grid-template-columns: repeat(4, 1fr); margin-top: clamp(56px, 7vw, 88px); border-top: 1px solid var(--line); border-left: 1px solid var(--line); }
  .card { padding: 22px 22px 28px; border-right: 1px solid var(--line); border-bottom: 1px solid var(--line); min-height: 150px; transition: background .2s; display: flex; flex-direction: column; justify-content: space-between; gap: 22px; }
  .card:hover { background: var(--bg-raised); }
  .card-top { display: flex; gap: 12px; color: var(--text); }
  .card p { margin: 0; color: var(--text-2); font-size: 15px; line-height: 1.4; }
  .card-cta { background: var(--bg-raised); }
  .card-cta .cta-link { color: var(--text); font-size: 22px; }
  .card-cta:hover { background: var(--bg-panel); }
  @media (max-width: 1100px) { .cards { grid-template-columns: repeat(3, 1fr); } }
  @media (max-width: 800px) { .cards { grid-template-columns: repeat(2, 1fr); } }
  @media (max-width: 480px) { .cards { grid-template-columns: 1fr; } .card { min-height: 0; } }

  .map-frame { margin-top: clamp(40px, 5vw, 64px); }

  /* safety */
  .promises { list-style: none; padding: 0; margin: 0; display: grid; border-top: 1px solid var(--line); }
  .promises li { display: grid; grid-template-columns: 36px 1fr; gap: 12px; padding: 16px 0; border-bottom: 1px solid var(--line); color: var(--text-2); font-size: 16px; line-height: 1.4; }
  .journal { background: var(--term); border: 1px solid var(--line-strong); }
  .journal ol { list-style: none; margin: 0; padding: 6px 0; }
  .journal li { display: grid; grid-template-columns: 80px 1fr; gap: 14px; padding: 15px 18px; border-bottom: 1px dashed var(--line); }
  .journal li:last-child { border-bottom: 0; }
  .journal.reveal li { opacity: 0; transform: translateX(-6px); transition: opacity .45s ease var(--d), transform .45s ease var(--d); }
  .journal.reveal.in li { opacity: 1; transform: none; }
  .op { font-size: 11.5px; font-weight: 600; letter-spacing: .08em; padding: 2px 0; }
  .op-intent { color: #7dd3fc; }
  .op-check { color: var(--warn); }
  .op-trash { color: var(--accent); }
  .op-commit { color: var(--ok); }
  .j-what { display: block; font-weight: 500; }
  .j-why { display: block; font-size: 14px; margin-top: 2px; color: var(--text-3); }

  /* speed */
  .speed-hero { display: grid; grid-template-columns: auto 1fr; gap: clamp(32px, 5vw, 72px); align-items: center; margin-top: clamp(48px, 6vw, 80px); }
  .speed-num { font-size: clamp(64px, 11vw, 168px); white-space: nowrap; }
  .speed-num .to { font-weight: 300; }
  .speed-copy { margin: 0 0 22px; font-size: 18px; line-height: 1.35; color: var(--text); max-width: 34ch; }
  @media (max-width: 960px) { .speed-hero { grid-template-columns: 1fr; } }
  .bench { margin-top: clamp(48px, 6vw, 72px); border-top: 1px solid var(--line); }
  .bench-row { display: grid; grid-template-columns: 240px 1fr 110px; gap: 24px; align-items: center; padding: 20px 0; border-bottom: 1px solid var(--line); }
  .bench-row .label { color: var(--text); }
  .bench-bars { display: grid; gap: 4px; }
  .bench-bars > span { height: 22px; width: var(--w); display: flex; align-items: center; padding: 0 8px; font-size: 11.5px; }
  .bar-before { background: repeating-linear-gradient(135deg, rgba(242,242,240,.1) 0 1px, transparent 1px 6px); color: var(--text-3); }
  .bar-after { background: var(--accent); color: #140a04; font-weight: 600; min-width: 48px; }
  .bench-row.reveal .bar-after { width: 0; transition: width 1.1s cubic-bezier(.2,.7,.2,1) .2s; }
  .bench-row.reveal.in .bar-after { width: var(--w); }
  .bench-x { font-size: 44px; text-align: right; }
  @media (max-width: 760px) { .bench-row { grid-template-columns: 1fr auto; } .bench-bars { grid-column: 1 / -1; grid-row: 2; } .bench-x { font-size: 32px; } }

  /* demo */
  .demo-frame { margin-top: clamp(40px, 5vw, 64px); padding: clamp(16px, 4vw, 56px); }
  .win-frame { background: var(--term); border: 1px solid var(--line-strong); box-shadow: 0 50px 120px -30px rgba(0,0,0,.9); max-width: 1100px; margin: 0 auto; }
  .win-frame img { width: 100%; height: auto; }

  /* terminals */
  .term { background: var(--term); border: 1px solid var(--line-strong); min-width: 0; }
  pre { margin: 0; padding: 20px 20px 22px; font-size: 13px; line-height: 1.75; overflow-x: auto; color: var(--text-2); }
  .caret { display: inline-block; width: 8px; height: 15px; background: var(--accent); vertical-align: -2px; margin-left: 4px; animation: blink 1.1s steps(1) infinite; }
  @keyframes blink { 50% { opacity: 0; } }
  .k { color: var(--accent); }
  .s { color: #e8d5c4; }
  .row-btns { display: flex; flex-wrap: wrap; gap: 10px; }

  /* posts */
  .posts-head { display: flex; justify-content: space-between; align-items: end; gap: 24px; flex-wrap: wrap; margin-top: clamp(40px, 5vw, 64px); }
  .posts { margin-top: 40px; border-top: 1px solid var(--line); }
  .post { display: grid; grid-template-columns: 48px 1.1fr 1fr 200px 20px; gap: 24px; align-items: baseline; padding: 26px 0; border-bottom: 1px solid var(--line); transition: background .2s, padding .2s; }
  .post:hover { background: var(--bg-raised); padding-left: 14px; padding-right: 14px; }
  .post .n { font-size: 12px; }
  .post-title { font: 560 clamp(20px, 2vw, 26px)/1.12 var(--font-display); letter-spacing: -0.015em; }
