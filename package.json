{
  "name": "freemydisk",
  "private": true,
  "version": "1.0.0",
  "description": "High-performance, safe-by-default disk cleaner & storage optimization suite for Windows & macOS.",
  "author": "Foysal Zihak <https://github.com/fzihak>",
  "license": "GPL-3.0",
  "homepage": "https://github.com/fzihak/FreeMyDisk#readme",
  "repository": {
    "type": "git",
    "url": "https://github.com/fzihak/FreeMyDisk.git"
  },
  "bugs": {
    "url": "https://github.com/fzihak/FreeMyDisk/issues"
  },
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "build:helpers": "cargo build --release -p freemydisk-elevated -p freemydisk-cli && node build-scripts/sync-helpers.cjs",
    "build:bundle-prep": "pnpm build && pnpm build:helpers",
    "build:bundle": "pnpm build:bundle-prep && pnpm tauri build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "tauri": "tauri"
  },
  "dependencies": {
    "@fluentui/react-icons": "^2.0.339",
    "@tauri-apps/api": "^2.2.0",
    "@tauri-apps/plugin-opener": "^2.2.5",
    "@tauri-apps/plugin-process": "^2.2.0",
    "@tauri-apps/plugin-updater": "^2.1.1",
    "clsx": "^2.1.1",
    "d3": "^7.9.0",
    "lucide-react": "^0.475.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "tailwind-merge": "^3.0.1",
    "zustand": "^5.0.3"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.0.8",
    "@tauri-apps/cli": "^2.11.4",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.2.0",
    "@types/d3": "^7.4.3",
    "@types/node": "^22.13.4",
    "@types/react": "^19.0.10",
    "@types/react-dom": "^19.0.4",
    "@vitejs/plugin-react": "^4.3.4",
    "jsdom": "^26.0.0",
    "tailwindcss": "^4.0.8",
    "typescript": "^5.7.3",
    "vite": "^6.1.0",
    "vitest": "^3.0.5"
  }
}
